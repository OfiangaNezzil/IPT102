<UserControl x:Class="LaundryManagement.Views.AddLaundryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#F3F6FB">

        <!-- Main Card -->
        <Border Width="520"
                Padding="35"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="3"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Add Laundry Order"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 30"/>

                <!-- Order ID -->
                <TextBlock Text="Order ID"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0 0 0 5"/>

                <Border Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Margin="0 0 0 18">

                    <TextBox Height="40"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12 8"
                             FontSize="14"
                             Text="{Binding OrderId}"/>
                </Border>

                <!-- Customer Name -->
                <TextBlock Text="Customer Name"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0 0 0 5"/>

                <Border Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Margin="0 0 0 18">

                    <TextBox Height="40"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12 8"
                             FontSize="14"
                             Text="{Binding CustomerName}"/>
                </Border>

                <!-- Contact Number -->
                <TextBlock Text="Contact Number"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0 0 0 5"/>

                <Border Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Margin="0 0 0 18">

                    <TextBox Height="40"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12 8"
                             FontSize="14"
                             Text="{Binding ContactNumber}"/>
                </Border>

                <!-- Service Type -->
                <TextBlock Text="Service Type"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0 0 0 5"/>

                <Border Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Margin="0 0 0 18">

                    <TextBox Height="40"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12 8"
                             FontSize="14"
                             Text="{Binding ServiceType}"/>
                </Border>

                <!-- Weight -->
                <TextBlock Text="Weight (kg)"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0 0 0 5"/>

                <Border Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Margin="0 0 0 18">

                    <TextBox Height="40"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12 8"
                             FontSize="14"
                             Text="{Binding WeightInKg}"/>
                </Border>

                <!-- Total Price -->
                <TextBlock Text="Total Price"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0 0 0 5"/>

                <Border Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Margin="0 0 0 30">

                    <TextBox Height="40"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12 8"
                             FontSize="14"
                             Text="{Binding TotalPrice}"/>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <!-- Save Button -->
                    <Button Content="Save"
                            Width="150"
                            Height="45"
                            Margin="0 0 12 0"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Foreground="White"
                            Background="#2563EB"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SaveCommand}">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Back Button -->
                    <Button Content="Back"
                            Width="150"
                            Height="45"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Foreground="#1E293B"
                            Background="#E2E8F0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding BackCommand}">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>